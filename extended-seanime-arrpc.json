{
    "id": "extended-seanime-arrpc",
    "name": "Extended Seanime arRPC",
    "version": "1.0.3",
    "manifestURI": "https://raw.githubusercontent.com/lustful-suicide/extended-seanime-arrpc/main/extended-seanime-arrpc.json",
    "language": "typescript",
    "type": "plugin",
    "description": "Forwards Seanime playback to a local arRPC server (standalone arrpc/arrpc-bun or the arRPC built into Equibop/Vesktop) so Discord Rich Presence shows up in custom clients like Equibop. Tries unix sockets discord-ipc-0..9, then WebSocket RPC (127.0.0.1:6463-6472).",
    "author": "lustful-suicide",
    "icon": "https://seanime.rahim.app/logo_2.png",
    "website": "https://github.com/lustful-suicide/extended-seanime-arrpc",
    "readme": "https://github.com/lustful-suicide/extended-seanime-arrpc/blob/main/README.md",
    "notes": "Zero-setup: install, grant permissions, done. The plugin spawns a companion daemon that finds Discord/arRPC sockets itself (including Flatpak sandbox sockets) and holds presence. Requires python3 on the Seanime server machine.",
    "lang": "multi",
    "payloadURI": "https://raw.githubusercontent.com/lustful-suicide/extended-seanime-arrpc/main/arrpc-bridge.ts",
    "plugin": {
        "version": "1",
        "permissions": {
            "scopes": [
                "playback",
                "system",
                "storage"
            ],
            "allow": {
                "readPaths": [
                    "$TEMP/*"
                ],
                "writePaths": [
                    "$TEMP/*"
                ],
                "commandScopes": [
                    {
                        "command": "python3",
                        "args": [
                            {
                                "validator": "$ARGS"
                            }
                        ],
                        "description": "Runs the bundled stdlib-only arRPC sender (written to $TEMP) to push presence to 127.0.0.1:6463-6472 / discord-ipc sockets."
                    },
                    {
                        "command": "python",
                        "args": [
                            {
                                "validator": "$ARGS"
                            }
                        ],
                        "description": "Fallback python binary for the bundled arRPC sender (Windows)."
                    },
                    {
                        "command": "py",
                        "args": [
                            {
                                "validator": "$ARGS"
                            }
                        ],
                        "description": "Fallback python launcher for the bundled arRPC sender (Windows)."
                    }
                ]
            }
        }
    }
}
